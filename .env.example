# Contact-form delivery. Configure these in Vercel for Production and Preview.
# Preferred dedicated key for contact-form delivery.
CONTACT_RESEND_API_KEY=
# Optional fallback when Resend is connected through Vercel Marketplace.
RESEND_API_KEY=
# One address or a comma-separated list of recipients.
CONTACT_TO_EMAIL=
# Must use a sender/domain verified by the chosen email provider.
CONTACT_FROM_EMAIL=

# Optional URL-prefix Search Console verification token (content value only).
# Domain-property verification should still be completed with Google's DNS TXT record.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public site-scoped ingestion only; never place a user/provider/backend secret here.
# Preview hosts deliberately send no capture. Configure the distinct Trinity key.
PUBLIC_HERMAION_SITE_KEY=
# Optional: pathname, referrer origin and ephemeral per-tab token only.
PUBLIC_HERMAION_TRACK_PAGEVIEWS=false
