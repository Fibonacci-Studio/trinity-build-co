---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ImageBand from "../components/ImageBand.astro";
import { servicePages } from "../data/servicePages";
import bandPhoto from "../assets/photos/13-hardhat-plans-detail.png";
---

<Base
  title="Commercial Construction Services | Trinity Build Co."
  description="Phoenix and Arizona commercial construction services: general contracting, design-build, construction management, preconstruction, and tenant improvements."
>
  <Nav active="services" />
  <main id="main-content">
    <PageHero
      eyebrow="What We Do"
      title="Commercial construction services."
      titleMaxWidth="960px"
      lede="Nine core services, one accountable team. From first budget to final closeout, every phase is planned, priced, and delivered with discipline."
    />

    <ImageBand
      image={bandPhoto}
      alt="Hardhat resting on construction plans"
      height="clamp(320px, 42vw, 520px)"
      gradient="linear-gradient(180deg, rgba(13,13,13,0.55) 0%, rgba(13,13,13,0.1) 40%, rgba(13,13,13,0.72) 100%)"
      objectPosition="center 46%"
      eyebrow="Discipline, Documented"
      caption="Every project begins on paper — planned, priced, and pressure-tested before a shovel hits the ground."
    />

    <section class="services-detail">
      <div class="container">
        {
          servicePages.map((service, i) => (
            <div class="service-row" id={service.id} data-reveal>
              <div class="service-num">{String(i + 1).padStart(2, "0")}</div>
              <div>
                <h2 class="service-title">
                  <a href={`/services/${service.slug}`}>{service.title}</a>
                </h2>
                <p class="service-copy">{service.hubCopy}</p>
                <a class="service-detail-link" href={`/services/${service.slug}`}>View Service Details →</a>
              </div>
              <div class="service-bullets">
                {service.hubBullets.map((bullet) => (
                  <div class="bullet">
                    <span class="bullet-dash" aria-hidden="true">
                      —
                    </span>
                    <span class="bullet-text">{bullet}</span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }

        <div class="services-cta">
          <a href="/contact" class="btn btn--sage" data-analytics-cta="request_proposal" data-analytics-placement="services_page">Request a Proposal</a>
          <a href="/process" class="btn btn--outline-dark">See How We Work</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .services-detail {
    background: #ffffff;
    padding: clamp(72px, 9vw, 96px) 0 var(--section-pad);
  }

  .service-row {
    border-top: 1px solid var(--color-line);
    padding: 46px 0;
    scroll-margin-top: 112px;
    display: grid;
    grid-template-columns: minmax(70px, 90px) minmax(320px, 1.15fr) minmax(280px, 0.85fr);
    gap: 40px;
  }

  .service-row:last-of-type {
    border-bottom: 1px solid var(--color-line);
  }

  .service-num {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-gold-dark);
  }

  .service-title {
    margin: 0 0 14px;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .service-title a {
    color: inherit;
    text-decoration: none;
  }

  .service-title a:hover {
    color: var(--color-sage-dark);
  }

  .service-copy {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-stone);
  }

  .service-detail-link {
    display: inline-block;
    margin-top: 20px;
    color: var(--color-sage-dark);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .service-detail-link:hover {
    color: var(--color-gold-dark);
  }

  .service-bullets {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
  }

  .bullet {
    display: flex;
    gap: 14px;
    align-items: baseline;
  }

  .bullet-dash {
    color: var(--color-gold);
    font-weight: 700;
  }

  .bullet-text {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-stone);
  }

  .services-cta {
    margin-top: 64px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 980px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 40px 0;
    }

    .service-bullets {
      padding-top: 0;
    }
  }
</style>
