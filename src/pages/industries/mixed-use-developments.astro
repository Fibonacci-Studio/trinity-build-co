const deliveryItems = [
  {
    title: "Interface Management",
    copy: "Responsibility and information are tracked where building uses, systems, scopes, and schedules intersect so gaps can be addressed early.",
  },
  {
    title: "Milestone Alignment",
    copy: "Design, permitting, utility, procurement, tenant, construction, and occupancy dates are reviewed as one connected sequence.",
  },
  {
    title: "Decision Visibility",
    copy: "Current assumptions, approvals, cost considerations, and open questions give ownership a clear view of decisions affecting the full program.",
  },
  {
    title: "Phased Site Control",
