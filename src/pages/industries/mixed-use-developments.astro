  {
    title: "Use-Specific Coordination",
    copy: "Track the structural, MEP, life-safety, acoustic, envelope, and finish interfaces that change where residential and commercial programs meet.",
  },
  {
    title: "Tenant & Stakeholder Logistics",
    copy: "Organize access, approvals, information, deliveries, and handoffs for owners, designers, utilities, tenants, and trade partners as the project develops.",
  },
  {
    title: "Phasing & Turnover",
    copy: "Build inspections, tenant readiness, common-area completion, life-safety requirements, and occupancy milestones into a coordinated release plan.",
  },
