---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactRows from "../components/ContactRows.astro";
import { business } from "../config";
import sitePhoto from "../assets/photos/20-site-entrance-fencing.png";

const contactRows = [
  { label: "Phone", value: business.phone, href: business.phoneHref },
  { label: "Email", value: business.email, href: `mailto:${business.email}` },
  { label: "License", value: business.rocLicense, href: business.rocLicenseUrl },
  { label: "Careers", value: business.careersEmail, href: `mailto:${business.careersEmail}` },
];
---

<Base
  title="Contact a Phoenix General Contractor | Trinity Build Co."
  description="Tell us about your project and a member of our leadership team will respond within one business day. Phoenix, Arizona commercial general contractor."
>
  <Nav active="none" />
  <main id="main-content">
    <section class="contact-page">
      <div class="container">
        <div class="eyebrow contact-eyebrow"><span>Start Your Project</span></div>
        <h1 class="page-title contact-title">Let's build something that lasts.</h1>
        <p class="contact-lede">
          Tell us about your project and a member of our leadership team will respond within one
          business day.
        </p>

        <div class="contact-grid">
          <div data-reveal>
            <h2 class="contact-section-title">Contact Trinity Build Co.</h2>
            <ContactRows rows={contactRows} large />
            <Image
              src={sitePhoto}
              alt="Construction site entrance with perimeter fencing"
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 48vw, 100vw"
              quality={75}
              class="contact-img"
            />
          </div>
          <div data-reveal>
            <h2 class="contact-section-title">Tell us about your project.</h2>
            <ContactForm rows={6} location="contact_page" />
          </div>
        </div>
        <div class="contact-guidance">
          <h3>What to include in your inquiry</h3>
          <p>
            Trinity works with commercial owners and project teams across Arizona. Whether
            you are planning a new building or adapting an existing space, a few details
            help make the first conversation useful:
          </p>
          <ul>
            <li>The project city and whether the site is new, existing, or still being evaluated.</li>
            <li>How the space will be used, the work you have in mind, and any occupied areas.</li>
            <li>Your target schedule, budget range if known, and the decisions still ahead.</li>
            <li>Whether an architect, drawings, or a construction team is already in place.</li>
          </ul>
          <p>
            You do not need a finished design to start a conversation. Use the message
            field for a short overview; do not include confidential plans or sensitive
            financial information in the form.
          </p>
          <h3>Choose the right starting point</h3>
          <p>
            For a new facility, explore <a href="/services/ground-up-commercial-construction">ground-up construction</a>.
            For an existing commercial space, review <a href="/services/tenant-improvements">tenant improvements</a>.
            If scope, cost, or sequencing is still taking shape,
            <a href="/services/preconstruction">preconstruction planning</a> can help frame those questions.
          </p>
          <p>
            Our <a href="/process">construction process</a> begins with goals, site conditions,
            budget, and schedule before moving into planning and team coordination.
            Prefer to talk first? Call or email using the contact details above.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer showCta={false} />
</Base>

<style>
  .contact-page {
    background: var(--color-ink);
    padding: clamp(72px, 9vw, 96px) 0 var(--section-pad);
  }

  .contact-eyebrow {
    margin-bottom: 28px;
  }

  .contact-title {
    max-width: 960px;
  }

  .contact-lede {
    margin: 28px 0 0;
    font-size: 18px;
    line-height: 1.75;
    color: var(--color-dust-muted);
    max-width: 620px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 80px;
    align-items: start;
    margin-top: 80px;
  }

  .contact-section-title {
    margin: 0 0 28px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .contact-guidance {
    max-width: 820px;
    margin-top: 64px;
    color: var(--color-dust-muted);
    font-size: 16px;
    line-height: 1.75;
  }

  .contact-guidance h3 {
    color: #ffffff;
    font-size: 19px;
    margin: 28px 0 12px;
  }

  .contact-guidance p { margin: 12px 0; }
  .contact-guidance ul { padding-left: 22px; }
  .contact-guidance li + li { margin-top: 8px; }
  .contact-guidance a { color: var(--color-gold-light); text-underline-offset: 3px; }

  .contact-img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    margin-top: 48px;
  }

  @media (max-width: 700px) {
    .contact-grid {
      margin-top: 56px;
      gap: 56px;
    }
  }
</style>
