---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import multiFamily from "../assets/photos/work-areas/01-multi-family-developments.png";
import apartments from "../assets/photos/work-areas/02-apartment-communities.png";
import mixedUse from "../assets/photos/work-areas/03-mixed-use-developments.png";
import office from "../assets/photos/work-areas/04-office-buildings.png";
import campus from "../assets/photos/work-areas/05-commercial-campuses.png";
import medical from "../assets/photos/11-medical-ti-framing.png";
import warehouse from "../assets/photos/07-tilt-up-warehouse-crew.png";
import fleet from "../assets/photos/12-branded-fleet-tool-trailer.png";
import walkthrough from "../assets/photos/03-tenant-improvement-walkthrough.png";
import glass from "../assets/photos/09-glass-partition-installation.png";
import illuminateBar from "../assets/photos/projects/illuminate-community-church/illuminate-bar-kitchen.jpg";
import illuminateLounge from "../assets/photos/projects/illuminate-community-church/illuminate-lounge.jpg";

interface Project {
  image: ImageMetadata;
  alt: string;
  title: string;
  href?: string;
}

const projects: Project[] = [
  {
    image: multiFamily,
    alt: "Multi-family development under construction",
    title: "Multi-Family Developments",
    href: "/industries/multi-family-developments",
  },
  {
    image: apartments,
    alt: "Apartment community under construction",
    title: "Apartment Communities",
    href: "/industries/apartment-communities",
  },
  {
    image: mixedUse,
    alt: "Mixed-use development under construction",
    title: "Mixed-Use Developments",
    href: "/industries/mixed-use-developments",
  },
  {
    image: office,
    alt: "Commercial office construction site",
    title: "Office Buildings",
    href: "/industries/office-buildings",
  },
  {
    image: campus,
    alt: "Commercial campus under construction",
    title: "Commercial Campuses",
    href: "/industries/commercial-campuses",
  },
  {
    image: medical,
    alt: "Medical tenant-improvement framing",
    title: "Medical",
  },
  {
    image: warehouse,
    alt: "Tilt-up warehouse construction site",
    title: "Industrial & Warehouse",
  },
  {
    image: fleet,
    alt: "Construction vehicles and tool trailer",
    title: "Retail",
  },
  {
    image: walkthrough,
    alt: "Walkthrough inside a tenant-improvement space",
    title: "Tenant Improvement",
  },
  {
    image: glass,
    alt: "Glass partition installation in an office buildout",
    title: "Office Interiors",
  },
];
---

<Base
  title="Featured Commercial Projects | Trinity Build Co."
  description="Explore Trinity Build Co. commercial projects and the construction sectors the company serves across Arizona."
  ogImage={illuminateBar.src}
>
  <Nav active="portfolio" />
  <main id="main-content">
    <PageHero
      eyebrow="Featured Projects"
      title="Spaces built to work—and bring people together."
      titleMaxWidth="1040px"
    />

    <section class="featured-project">
      <div class="container">
        <a
          href="/portfolio/illuminate-community-church"
          class="featured-project-card"
          aria-label="View the Illuminate Community Church renovation case study"
          data-reveal
        >
          <div class="featured-project-copy">
            <span class="featured-project-kicker">Project Spotlight</span>
            <h2>Illuminate Community Church</h2>
            <p>
              A high-end Scottsdale church renovation shaped around hospitality and connection,
              with a custom café bar, full kitchen, gathering spaces, meeting rooms, and refined
              restrooms.
            </p>
            <span class="featured-project-link">View Case Study →</span>
          </div>
          <div class="featured-project-media">
            <Image
              src={illuminateBar}
              alt="Custom patterned-tile café bar at Illuminate Community Church"
              widths={[560, 800, 1200]}
              sizes="(min-width: 900px) 50vw, 100vw"
              quality={78}
              loading="eager"
              class="featured-project-img"
            />
            <div class="featured-project-image-label">Scottsdale, AZ · Church Renovation</div>
          </div>
        </a>
        <div class="featured-project-secondary" data-reveal>
          <Image
            src={illuminateLounge}
            alt="Connect lounge inside Illuminate Community Church"
            widths={[480, 800, 1200]}
            sizes="(min-width: 760px) 44vw, 100vw"
            quality={75}
            loading="lazy"
          />
          <div>
            <span>Completed 2024</span>
            <h3>Inside the Scottsdale renovation</h3>
            <p>
              The Illuminate Community Church case study documents a commercial interior
              buildout for hospitality, meetings, and community gatherings. The photographed
              spaces include a café bar with patterned tile, a full hospitality kitchen,
              a lounge, meeting rooms, a multipurpose hall, and renovated restrooms.
            </p>
            <p>
              Explore the <a href="/portfolio/illuminate-community-church">project gallery and scope</a>
              for room-by-room views of the cabinetry, millwork, flooring, and finish coordination.
              These details show how the different spaces support everyday use within one renovation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="grid-section">
      <div class="container">
        <div class="capability-head" data-reveal>
          <div class="eyebrow"><span>Commercial Capabilities</span></div>
          <h2>Project types we are built to deliver.</h2>
          <p>
            The sectors below describe Trinity's commercial capabilities, rather than a list
            of named completed projects. Use the linked industry pages to explore the needs
            of multi-family developments, apartment communities, mixed-use properties,
            office buildings, and commercial campuses.
          </p>
          <p>
            A project may begin with a new site, an existing building, or a space that needs
            to serve a different purpose. Trinity's services cover ground-up construction,
            tenant improvements, design-build, and construction management, with
            preconstruction planning to address scope, budget, and schedule.
          </p>
          <p>
            Comparing these capabilities with your own plans?
            <a href="/services">Review the services</a> or
            <a href="/contact">tell us about your project</a> to discuss its location, intended use,
            and the work you are considering.
          </p>
        </div>
        <div class="project-grid">
          {
            projects.map((project) => (
              <div data-reveal>
                <Image
                  src={project.image}
                  alt={project.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 760px) 48vw, 100vw"
                  quality={75}
                  class="project-img"
                />
                <div class="project-caption">
                  {
                    project.href ? (
                      <a class="caption-title caption-title--link" href={project.href}>
                        {project.title}
                      </a>
                    ) : (
                      <span class="caption-title">{project.title}</span>
                    )
                  }
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .featured-project {
    background: var(--color-ink);
    padding: 0 0 clamp(76px, 9vw, 112px);
  }

  .featured-project-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    overflow: hidden;
    border: 1px solid rgba(200, 161, 90, 0.4);
    color: inherit;
    text-decoration: none;
    background: linear-gradient(130deg, #171512, #0d0d0d 58%);
    transition: border-color 0.25s;
  }

  .featured-project-card:hover {
    border-color: var(--color-gold);
  }

  .featured-project-card:focus-visible {
    outline: 2px solid var(--color-gold-light);
    outline-offset: 5px;
  }

  .featured-project-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(36px, 5vw, 64px);
  }

  .featured-project-kicker {
    color: var(--color-gold);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .featured-project-copy h2,
  .capability-head h2 {
    margin: 18px 0 0;
    font-size: clamp(30px, 4vw, 50px);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .featured-project-copy p {
    max-width: 520px;
    margin: 22px 0 0;
    color: var(--color-dust-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .featured-project-link {
    margin-top: 30px;
    color: var(--color-gold-light);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .featured-project-media {
    position: relative;
    min-height: 470px;
    overflow: hidden;
    background: #171512;
  }

  .featured-project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .featured-project-card:hover .featured-project-img {
    transform: scale(1.025);
  }

  .featured-project-media::after {
    content: "";
    position: absolute;
    inset: 55% 0 0;
    background: linear-gradient(transparent, rgba(5, 5, 5, 0.72));
  }

  .featured-project-image-label {
    position: absolute;
    z-index: 1;
    right: 26px;
    bottom: 24px;
    left: 26px;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .featured-project-secondary {
    display: grid;
    grid-template-columns: minmax(220px, 0.38fr) minmax(0, 0.62fr);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
    margin-top: 22px;
    padding: 22px;
    border: 1px solid var(--color-coal-border);
  }

  .featured-project-secondary :global(img) {
    width: 100%;
    max-height: 230px;
    object-fit: cover;
  }

  .featured-project-secondary h3 {
    margin: 16px 0;
    color: #ffffff;
    font-size: 22px;
    line-height: 1.3;
  }

  .featured-project-secondary p,
  .capability-head p {
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 1.75;
  }

  .featured-project-secondary p { color: var(--color-dust-muted); }
  .featured-project-secondary a { color: var(--color-gold-light); text-underline-offset: 3px; }
  .capability-head a { color: var(--color-sage-dark); text-underline-offset: 3px; }

  .featured-project-secondary span {
    color: var(--color-gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .grid-section {
    background: #ffffff;
    padding: clamp(72px, 9vw, 100px) 0 var(--section-pad);
  }

  .capability-head {
    max-width: 780px;
    margin-bottom: 54px;
    color: var(--color-ink);
  }

  .capability-head .eyebrow {
    margin-bottom: 20px;
  }

  .capability-head .eyebrow span {
    color: var(--color-gold-dark);
  }

  .capability-head h2 {
    margin-top: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .project-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  .project-caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 18px;
    gap: 16px;
  }

  .caption-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .caption-title--link {
    text-decoration-color: var(--color-gold);
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .caption-title--link:hover {
    color: var(--color-sage-dark);
  }

  @media (max-width: 759px) {
    .featured-project-card,
    .featured-project-secondary {
      grid-template-columns: 1fr;
    }

    .featured-project-media {
      min-height: 320px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-img {
      height: clamp(240px, 56vw, 420px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-project-img {
      transition: none;
    }
  }
</style>
