---
import "@fontsource-variable/archivo";
import archivoLatinFont from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import { business } from "../config";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = business.description,
  ogImage = "/og-image.jpg",
  noindex = false,
  structuredData = [],
} = Astro.props;

const siteURL = Astro.site?.href ?? business.url;
const resolvedOgImage = new URL(ogImage, siteURL).href;
const canonical = new URL(Astro.url.pathname, siteURL).href;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Keep the global entity graph conservative until leadership claims and official
// profiles are client-approved. The legal name and ROC number mirror the
// client-supplied Arizona ROC record; no street address is asserted yet.
// Page-specific WebPage data is safe because it mirrors the visible document.
const organizationSchema = {
  "@type": "GeneralContractor",
  "@id": `${siteURL}#organization`,
  name: business.name,
  legalName: business.legalName,
  slogan: business.tagline,
  description: business.description,
  url: siteURL,
  logo: new URL("/icon-512.png", siteURL).href,
  image: resolvedOgImage,
  telephone: "+16027089986",
  email: business.email,
  areaServed: business.areaServed,
  identifier: {
    "@type": "PropertyValue",
    propertyID: "Arizona Registrar of Contractors",
    value: business.rocLicenseNumber,
  },
  ...(business.sameAs.length ? { sameAs: business.sameAs } : {}),
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    {
      "@type": "WebSite",
      "@id": `${siteURL}#website`,
      url: siteURL,
      name: business.name,
      description: business.description,
      publisher: { "@id": `${siteURL}#organization` },
      inLanguage: "en-US",
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": `${siteURL}#website` },
      about: { "@id": `${siteURL}#organization` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: resolvedOgImage,
      },
      inLanguage: "en-US",
    },
    ...structuredData,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0D0D0D" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href={archivoLatinFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>
      import { track } from "@vercel/analytics";

      // Conversion events intentionally exclude names, emails, phone numbers,
      // messages, and other lead data. Custom events require Vercel Pro/Enterprise.
      const disableImageDragging = () => {
        document.querySelectorAll("img").forEach((image) => {
          image.draggable = false;
        });
      };

      disableImageDragging();
      document.addEventListener("astro:page-load", disableImageDragging);
      document.addEventListener("dragstart", (event) => {
        if ((event.target as Element | null)?.closest("img, picture")) {
          event.preventDefault();
        }
      });

      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[href]");
        if (!link) return;

        const href = link.getAttribute("href") || "";
        const placement =
          link.dataset.analyticsPlacement ||
          (link.closest("header") ? "header" : link.closest("footer") ? "footer" : "page");

        if (href.startsWith("tel:")) {
          track("Phone Click", { placement });
        } else if (href.startsWith("mailto:")) {
          track("Email Click", { placement });
        }

        if (link.dataset.analyticsCta) {
          track("CTA Click", {
            placement,
            cta: link.dataset.analyticsCta,
          });
        }
      });
    </script>
    <SpeedInsights />
  </body>
</html>
